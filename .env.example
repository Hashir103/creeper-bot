# Copy to .env and fill in. .env is ignored by git.

# From the Discord developer portal (the bot's token, its application ID, and
# the server ID, with developer mode on in Discord to copy IDs).
token=
clientId=
guildId=

# Only members with this role can use /dev. Leave empty and nobody can.
ADMIN_ROLE_ID=

# The live status message, dev activity and the log of /dev actions go here.
UPDATES_CHANNEL_ID=
# Alerts (speaker offline, restarts). Defaults to the updates channel.
ALERTS_CHANNEL_ID=

# Where the radio runs on this machine. These are the defaults.
# DJ_URL=http://127.0.0.1:20032
# DJ_DIR=/home/ubuntu/dj
# DJ_SERVICE=dj
# RADIO_URL=https://dj.hashir.tech
# GITHUB_REPO=Hashir103/public-dj-project
